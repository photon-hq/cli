{
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@clack/prompts": "1.7.0",
    "@gunshi/plugin-completion": "1.0.0-rc.5",
    "@gunshi/plugin-suggestion": "1.0.0-rc.5",
    "@photon-ai/api": "npm:@photon-ai/api@0.6.0",
    "@photon-ai/api-public": "npm:@photon-ai/api@0.6.0",
    "@types/node": "22.20.1",
    "bun": "1.4.4",
    "env-paths": "4.0.0",
    "esbuild": "0.28.1",
    "fast-string-width": "3.0.2",
    "gunshi": "1.0.0-rc.5",
    "open": "11.0.0",
    "ora": "10.0.0",
    "qrcode": "1.5.4",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "ultracite": "7.9.4",
    "undici": "7.30.2",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "2.1.2"
  },
  "imports": {
    "#build-config": {
      "photon-internal": "./config/cli.staging.json",
      "default": "./config/cli.production.json"
    },
    "#internal": {
      "photon-internal": "./src/internal/index.ts",
      "default": "./src/app/no-internal.ts"
    },
    "#sdk-version": {
      "photon-internal": "./src/internal/sdk-version.ts",
      "default": "./src/sdk-version.ts"
    }
  },
  "name": "@photon-ai/cli",
  "scripts": {
    "cli": "tsx --import ./scripts/public-sdk.mjs src/bin.ts",
    "dev": "tsx --import ./scripts/public-sdk.mjs --watch src/bin.ts",
    "build": "pnpm clean && node scripts/build-javascript.mjs",
    "build:binary": "bun run scripts/build-local-binary.mjs",
    "build:binaries": "bun run scripts/build-binaries.mjs",
    "check": "pnpm check:config && pnpm lint && pnpm typecheck && pnpm test:production && pnpm test:release && pnpm test:production-plan && pnpm build",
    "check:biome": "ultracite check",
    "check:fix": "ultracite fix",
    "clean": "node scripts/clean.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "ultracite check",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.public.json",
    "test": "vitest run --config vitest.production.config.ts --test-timeout=15000",
    "test:production": "vitest run --config vitest.production.config.ts --test-timeout=15000",
    "test:native-storage": "tsx scripts/test-native-credential-store.ts",
    "test:watch": "vitest --config vitest.production.config.ts",
    "smoke": "node dist/bin.js --version && node dist/bin.js --help",
    "prepack": "pnpm check",
    "fix": "ultracite fix",
    "docs:reference": "tsx scripts/export-docs.ts",
    "check:config": "node scripts/build-config.mjs production",
    "test:production-plan": "tsx scripts/production-test/index.ts check",
    "test:release": "node --test scripts/build-config.production.node-test.mjs"
  },
  "type": "module",
  "version": "3.0.0",
  "description": "Photon CLI built with Gunshi for Node.js and standalone binaries.",
  "bin": {
    "photon": "./dist/bin.js",
    "pho": "./dist/bin.js"
  },
  "files": [
    "dist/bin.js",
    "dist/bin.js.map",
    "dist/THIRD_PARTY_NOTICES.txt",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/photon-hq/cli.git"
  },
  "homepage": "https://github.com/photon-hq/cli#readme",
  "bugs": {
    "url": "https://github.com/photon-hq/cli/issues"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org",
    "tag": "latest"
  }
}
